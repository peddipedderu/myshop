# ================================================
# Pinkcycle - Environment Configuration Template
# ================================================
# Copy this file to myshop/local_settings.py and fill in the values.
# NEVER commit the actual local_settings.py to version control.

# Django Secret Key (generate a new one for production)
SECRET_KEY = 'your-secret-key-here'

# Debug mode (set to False in production)
DEBUG = True

# Allowed Hosts
ALLOWED_HOSTS = ['*', 'yourdomain.com', 'your-ip-address']
CSRF_TRUSTED_ORIGINS = [
    'https://yourdomain.com',
    'http://localhost',
    'http://127.0.0.1',
]
CSRF_COOKIE_SECURE = True
SESSION_COOKIE_SECURE = True
CSRF_COOKIE_SAMESITE = 'None'
SESSION_COOKIE_SAMESITE = 'None'

# Stripe API Keys
STRIPE_PUBLISHABLE_KEY = 'pk_test_...'
STRIPE_SECRET_KEY = 'sk_test_...'
STRIPE_API_VERSION = '2024-04-10'

# Google OAuth
GOOGLE_CLIENT_ID = 'your-google-client-id'
GOOGLE_CLIENT_SECRET = 'your-google-client-secret'

